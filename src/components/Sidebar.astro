---
const items = [
  { href: '/#top', en: 'TOP', ja: '' },
  { href: '/#greeting', en: 'GREETING', ja: 'ごあいさつ' },
  { href: '/#profile', en: 'PROFILE', ja: 'プロフィール' },
  { href: '/#research', en: 'RESEARCH', ja: '研究' },
  { href: '/news', en: 'NEWS', ja: '近況' },
  { href: '/#outreach', en: 'OUTREACH', ja: '登壇' },
  { href: '/#interests', en: 'INTERESTS', ja: '趣味' },
  { href: '/#contact', en: 'CONTACT', ja: '連絡' },
];
---

<aside class="sidebar">
  <a href="/" class="site-name">Taichi Abe<br />阿部 太一</a>
  <p class="site-sub">chitabea.com</p>

  <nav>
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href}>
            {item.en}
            {item.ja && <span class="ja">{item.ja}</span>}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar-footer">
    © 2026 Taichi Abe<br />
    chitabea.com
  </div>
</aside>

<style>
  .sidebar {
    width: var(--nav-w);
    min-height: 100vh;
    position: fixed;
    top: 0; left: 0;
    background: var(--bg);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    padding: 2.8rem 2rem 2rem;
    z-index: 100;
  }

  .site-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent);
    line-height: 1.3;
    margin-bottom: .3rem;
    text-decoration: none;
  }

  .site-sub {
    font-size: .72rem;
    color: var(--sub);
    letter-spacing: .03em;
    margin-bottom: 3rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  nav a {
    display: block;
    font-size: .8rem;
    letter-spacing: .08em;
    color: var(--sub);
    text-decoration: none;
    padding: .45rem .6rem;
    border-radius: 4px;
    transition: all .2s;
  }

  nav a:hover {
    color: var(--accent);
    background: rgba(74, 140, 120, .08);
  }

  nav a .ja {
    font-size: .7rem;
    margin-left: .4rem;
    opacity: .6;
  }

  .sidebar-footer {
    margin-top: auto;
    font-size: .65rem;
    color: var(--border);
    line-height: 1.8;
  }

  @media (max-width: 768px) {
    .sidebar {
      width: 100%;
      min-height: auto;
      position: static;
      border-right: none;
      border-bottom: 1px solid var(--border);
      flex-direction: row;
      flex-wrap: wrap;
      padding: 1rem 1.5rem;
      gap: .5rem;
    }
    .site-name { margin-bottom: 0; }
    .site-sub { display: none; }
    nav ul { flex-direction: row; flex-wrap: wrap; gap: .2rem; }
    .sidebar-footer { display: none; }
  }
</style>
